# Nginx Configuration Template for Legado Web UI (Docker Platform)

# Port 4080: Serve the compiled Vue Web UI directly (full screen)
server {
    listen 4080;
    server_name localhost;

    # Gzip Compression
    gzip on;
    gzip_min_length 1000;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript application/x-javascript text/javascript text/xml application/xml application/xml+rss;
    gzip_vary on;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

# Port 4081: Transparent HTTP proxy to the App's native web service (default: 1122)
server {
    listen 4081;
    server_name localhost;

    # Intercept errors to display our beautiful setup guide if the phone is offline
    proxy_intercept_errors on;
    error_page 502 503 504 /proxy_error.html;

    # Route WebSocket connections from Port 4080 client (which shift to Port 4081)
    location /searchBook {
        proxy_pass ${BACKEND_WS_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location /bookSourceDebug {
        proxy_pass ${BACKEND_WS_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    location /rssSourceDebug {
        proxy_pass ${BACKEND_WS_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }

    # Proxy normal HTTP requests to the phone's web service (port 1122)
    location / {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Fallback troubleshooting guide
    location = /proxy_error.html {
        root /usr/share/nginx/html;
        internal;
    }
}

# Port 4082: Transparent WebSocket proxy to the App's native WebSocket server (default: 1123)
# (Used when Port 4081 is accessed, shifting WebSocket connections to Port 4082)
server {
    listen 4082;
    server_name localhost;

    location / {
        proxy_pass ${BACKEND_WS_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
